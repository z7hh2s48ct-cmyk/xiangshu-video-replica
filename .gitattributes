# Normalize all text files to LF in the repository, regardless of the
# platform they were committed from (prevents CRLF-only rewrites like
# bd73072 from ever reaching CI again).
* text=auto eol=lf

# Windows scripts must keep CRLF for cmd.exe compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.zip binary
*.exe binary
*.dll binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.wav binary
